{
  "name": "proerp",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "db:setup": "node scripts/db-setup.mjs",
    "db:columns": "node scripts/gen-columns.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:purge-test": "tsx scripts/purge-test-data.ts",
    "migrate:images": "tsx scripts/migrate-images-to-files.mts",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "user:password": "tsx scripts/set-password.ts",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/unitTests.ts",
    "test:isolated": "node scripts/test-db.mjs",
    "test:local-db": "node scripts/test-local-db.mjs",
    "test:integration": "tsx src/tests/integrationTests.ts",
    "test:delete": "tsx src/tests/deletePolicyTests.ts",
    "test:rbac": "tsx src/tests/rbacTests.ts",
    "test:colors": "tsx src/tests/colorTests.ts",
    "test:mold": "tsx src/tests/moldTests.ts",
    "test:load": "tsx src/tests/loadTest.ts"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.3",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
